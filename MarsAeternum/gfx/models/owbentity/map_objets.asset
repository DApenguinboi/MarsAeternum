	name = "helios_impact_entity"
	pdxmesh = "nuke_mesh"
	default_state = "attack"
	state = { name = "attack" animation = attack looping = no
		event = { time = 12.5 particle = "nuke_particle" keep_particle = yes sound = { soundeffect = "nuke" } }
