entity = {
	name = "laser_rifle_entity"
	pdxmesh = "laser_rifle_mesh"
	locator = { name = muzzle position = { 0 0 -2.5 } }
	scale = 0.9
	###inheret state from attached objects
	get_state_from_parent = yes
	default_state = "idle"
	state = { name = "idle" }
