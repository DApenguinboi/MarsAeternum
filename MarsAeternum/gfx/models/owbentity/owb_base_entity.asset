entity = {
	name = "owb_melee_4_entity"
	pdxmesh = "super_sledge_mesh"
	state = { name = idle animation = "idle" animation_blend_time = 0.0 propagate_state = { jet = "idle" } }
	state = { name = idle_attack animation = "idle_attack" animation_blend_time = 0.0 propagate_state = { jet = "idle" } }
